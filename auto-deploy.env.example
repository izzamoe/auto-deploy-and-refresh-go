# Bearer token for webhook authentication
# Must match the DEPLOY_WEBHOOK_SECRET secret in your GitHub repository settings
WEBHOOK_SECRET=your-secret-token-here

# Path to the binary file to replace on deployment
DEPLOY_BINARY_PATH=/root/pb/pocketbase

# Systemd service name to restart after deployment
DEPLOY_SERVICE_NAME=pocketbase.service

# Address and port to listen on
LISTEN_ADDR=:9000

# GitHub repository (owner/repo)
GITHUB_REPO=izzamoe/backend-kas

# Release artifact filename to download
ARTIFACT_NAME=kas-linux-arm64
