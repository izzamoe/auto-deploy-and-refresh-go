# HTTP listen address
LISTEN_ADDR=:9000

# SQLite database file path
DEPLOY_QUEUE_DB_PATH=deploy-queue.db

# Max pending deploys per app
DEPLOY_QUEUE_MAX=10

# DNS server used by download requests
DOWNLOAD_DNS=1.1.1.1

# There are NO admin credentials here: the first account (admin) gets a random password that is
# written to initial-admin-password next to the database (mode 0600). Read it, sign in at /admin/
# and change it; the file is deleted afterwards.

# Signing key of the admin sessions. Default: session.key next to the database (0600, created on
# first start). Keep it: deleting it signs every user out.
# SESSION_KEY_PATH=/opt/auto-deploy/session.key

# The session cookie carries the Secure flag (and the __Host- prefix) by DEFAULT. For plain-HTTP
# access (local development) set it to false explicitly, otherwise the browser drops the cookie.
# COOKIE_SECURE=false

# REQUIRED behind Cloudflare / cloudflared / a reverse proxy: comma-separated CIDRs or IPs whose
# CF-Connecting-IP / X-Forwarded-For are trusted as the client address (rate limits, audit log).
#   cloudflared on this host:  127.0.0.1/32      Cloudflare direct:  https://www.cloudflare.com/ips/
# Left empty, forwarding headers are ignored (a warning is logged) and every visitor shares the
# proxy's single rate-limit bucket.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Round interval of the shared systemd watcher behind the realtime service status of the admin
# panel (one `systemctl is-active` for every app per round, only while a tab shows it).
# A duration (5s) or seconds (5); default 5s, kept within 2s..60s.
# SERVICE_WATCH_INTERVAL=5s

# BOOTSTRAP ONLY — used on first startup if no apps exist in the registry.
# After the first app is created, manage apps via the admin UI at /admin/.
WEBHOOK_SECRET=your-secret-token-here
DEPLOY_BINARY_PATH=/root/pb/pocketbase
DEPLOY_SERVICE_NAME=pocketbase.service
GITHUB_REPO=izzamoe/backend-kas
ARTIFACT_NAME=kas-linux-arm64
