# HTTP listen address
LISTEN_ADDR=:9000

# SQLite database file path
DEPLOY_QUEUE_DB_PATH=deploy-queue.db

# Max pending deploys per app
DEPLOY_QUEUE_MAX=10

# DNS server used by download requests
DOWNLOAD_DNS=1.1.1.1

# Admin UI credentials (ADMIN_PASSWORD is required, no default)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# BOOTSTRAP ONLY — used on first startup if no apps exist in the registry.
# After the first app is created, manage apps via the admin UI at /admin/apps.
WEBHOOK_SECRET=your-secret-token-here
DEPLOY_BINARY_PATH=/root/pb/pocketbase
DEPLOY_SERVICE_NAME=pocketbase.service
GITHUB_REPO=izzamoe/backend-kas
ARTIFACT_NAME=kas-linux-arm64
