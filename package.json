{
  "name": "auto-deploy-playwright",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "pw:install": "playwright install chromium",
    "pw:smoke": "playwright test",
    "test:playwright": "playwright test",
    "admin:dev": "vite web/admin --config web/admin/vite.config.ts",
    "admin:build": "vite build web/admin --config web/admin/vite.config.ts && touch web/admin/dist/.keep",
    "admin:test": "vitest run web/admin --config web/admin/vite.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^24.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "^1.3.1"
  }
}
